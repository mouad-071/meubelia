# Public site URL. Used for canonical URLs and Open Graph metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Laravel API base URL as reached from the browser.
# Public by definition - never put a secret in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Laravel API base URL as reached from the Next.js server (Server Components,
# Route Handlers). May differ from the public URL in container deployments.
API_URL=http://localhost:8000/api
